---
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';
import { LinkCard } from '../../components/LinkCard';
import { SectionHeading } from '../../components/SectionHeading';
import { sections, audienceOf, sendsDataOf } from '../../lib/site-links';
import '../../styles/global.css';

// カードは src/lib/site-links.ts から作る。
// 以前はこのページが独自にカードを手書きしていて、**16個あるツールのうち
// 6個しか出ていなかった**(覚える君・関数電卓・PDFマージ・計算技術検定ドリル・
// 等式の変形テスト・大判プリント・可視化スタディ・シューティング・所見作成・
// 機能リクエストが抜けていた)。一覧の出どころを1つにすれば、この手の
// 取りこぼしは起きなくなる。
//
// フッターもこのページだけ独自に持っていて、Layout のフッターと二重に
// 出ていた(英文 "All processing is done locally in your browser." のもの)。
//
// 2026-07-31: site-links.ts の中身をメインサイトの一覧と同じにした。
// このページからも作戦盤・フローチャート・漢字ドリルなど、
// 独立ワーカーで動くツールまで辿れる。
---

<Layout
	title="ツール一覧 - 高校情報"
	description="高校生向けWebツール一覧。すべてブラウザ上で動作し、個人情報のサーバー送信なし。顔モザイク・PDFマージ・タイピング練習・席替えアプリなど。"
>
	<div class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
		<Header client:load currentPath={Astro.url.pathname} />

		<main class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
			<section class="mb-10">
				<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">ツール一覧</h1>
				<p class="mt-4 text-base leading-[1.8] text-slate-600 dark:text-slate-400">
					ほとんどのツールはブラウザの中だけで動き、入力した内容や画像を送信することはありません。
					<strong class="font-semibold text-slate-900 dark:text-slate-100">「共有・送信あり」</strong>
					の印が付いたものだけ、共有リンクを作ったり内容を送ったりしたときに通信します。
				</p>
			</section>

			{/* 絞り込み。JS が動かないときは出さない（押しても動かないボタンを出さない）。
			    その場合も全件が分類ごとに並ぶので、一覧としては成立している。 */}
			<nav data-audience-filter hidden aria-label="使う人でしぼり込む" class="mb-8">
				<p class="mb-3 text-base font-semibold text-slate-900 dark:text-slate-100">
					どなたが使いますか
				</p>
				<ul class="flex flex-wrap gap-2">
					{[
						{ value: 'all', label: 'すべて' },
						{ value: 'student', label: '生徒が使う' },
						{ value: 'teacher', label: '先生が使う' },
					].map((option) => (
						<li>
							<button
								type="button"
								data-audience={option.value}
								aria-pressed={option.value === 'all'}
								class="audience-tab min-h-11 rounded-full border border-slate-300 px-4 text-sm font-semibold dark:border-slate-700"
							>
								{option.label}
							</button>
						</li>
					))}
				</ul>
				<p role="status" aria-live="polite" class="sr-only" data-audience-status />
			</nav>

			{
				sections.map((section) => (
					<section class="mb-12" data-tool-section>
						<SectionHeading title={section.label} desc={section.desc} />
						<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{section.items.map((item) => (
								<LinkCard
									href={item.href}
									label={item.label}
									desc={item.desc}
									icon={item.icon}
									accent={item.accent}
									audience={audienceOf(item.href)}
									badge={sendsDataOf(item.href) ? '共有・送信あり' : undefined}
								/>
							))}
						</div>
					</section>
				))
			}
		</main>
	</div>
</Layout>

<style>
	.audience-tab {
		background: white;
		color: #0f172a;
	}

	:global(html.dark) .audience-tab {
		background: rgb(15 23 42 / 0.5);
		color: #f1f5f9;
	}

	/* 選択中は色だけでなく背景の濃さでも分かるようにする */
	.audience-tab[aria-pressed='true'] {
		background: #4f46e5;
		border-color: #4f46e5;
		color: #ffffff;
	}

	:global(html.dark) .audience-tab[aria-pressed='true'] {
		background: #6366f1;
		border-color: #6366f1;
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-audience-filter]');
	const tools = Array.from(document.querySelectorAll<HTMLElement>('[data-tool]'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-tool-section]'));

	if (nav && tools.length > 0) {
		nav.hidden = false;

		const status = nav.querySelector<HTMLElement>('[data-audience-status]');
		const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('button[data-audience]'));

		const apply = (selected: string) => {
			let shown = 0;
			for (const tool of tools) {
				// 'both' は「生徒が使う」でも「先生が使う」でも残す。
				// 迷うものを消してしまうと、探している人が見つけられなくなる
				const audience = tool.dataset.audience ?? 'both';
				const match = selected === 'all' || audience === selected || audience === 'both';
				tool.hidden = !match;
				if (match) shown += 1;
			}
			// 中身が全部消えた分類は、見出しごと隠す
			for (const group of groups) {
				const visible = Array.from(group.querySelectorAll<HTMLElement>('[data-tool]')).some(
					(tool) => !tool.hidden,
				);
				group.hidden = !visible;
			}
			for (const button of buttons) {
				button.setAttribute('aria-pressed', String(button.dataset.audience === selected));
			}
			if (status) status.textContent = `${shown}件を表示中`;
		};

		for (const button of buttons) {
			button.addEventListener('click', () => apply(button.dataset.audience ?? 'all'));
		}
	}
</script>
